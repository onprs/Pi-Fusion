{
  "name": "pi-fusion-router",
  "version": "0.3.0",
  "description": "Multi-model dynamic router for Pi Coding Agent powered by native decision classifiers",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onprs/Pi-Fusion.git"
  },
  "homepage": "https://github.com/onprs/Pi-Fusion#readme",
  "bugs": {
    "url": "https://github.com/onprs/Pi-Fusion/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "model-router",
    "classifier",
    "jev",
    "clef",
    "decision-1"
  ],
  "files": [
    "src",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "changelogPath": "./CHANGELOG.md"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typebox": "^1.3.27",
    "typescript": "^5.8.2"
  }
}
